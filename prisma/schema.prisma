generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SourceTier {
  HIGH
  MEDIUM
  SUPPORTING
}

enum PromiseStatus {
  NOT_STARTED
  IN_PROGRESS
  PARTIALLY_IMPLEMENTED
  IMPLEMENTED
  STALLED
  UNVERIFIABLE
}

enum UserRole {
  ADMIN
  RESEARCHER
}

model Election {
  id           String     @id @default(uuid())
  name         String
  electionDate DateTime
  level        String // e.g., "National", "State", "Local"
  jurisdiction String // e.g., "India", "Maharashtra"
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  manifestos   Manifesto[]
}

model PoliticalParty {
  id           String     @id @default(uuid())
  name         String
  abbreviation String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  manifestos   Manifesto[]
}

model Manifesto {
  id            String         @id @default(uuid())
  electionId    String
  partyId       String
  title         String
  documentUrl   String?
  publishedDate DateTime?
  version       String         @default("1.0")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  election      Election       @relation(fields: [electionId], references: [id], onDelete: Cascade)
  party         PoliticalParty @relation(fields: [partyId], references: [id], onDelete: Cascade)
  promises      Promise[]
}

model Promise {
  id                   String                @id @default(uuid())
  manifestoId          String
  title                String
  description          String
  category             String
  sourceText           String? // Original manifesto quote
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  manifesto            Manifesto             @relation(fields: [manifestoId], references: [id], onDelete: Cascade)
  evidences            Evidence[]
  verifications        Verification[]
  implementationStatus ImplementationStatus?
  statusHistory        StatusHistory[]
}

model Source {
  id         String         @id @default(uuid())
  name       String
  url        String
  sourceType String // e.g., "Government Gazette", "News Article", "Budget Document"
  tier       SourceTier
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  evidences  Evidence[]
  verifications Verification[]
}

model Evidence {
  id            String   @id @default(uuid())
  promiseId     String
  sourceId      String
  title         String
  description   String
  evidenceUrl   String?
  publishedDate DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  promise       Promise  @relation(fields: [promiseId], references: [id], onDelete: Cascade)
  source        Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(uuid())
  promiseId  String
  sourceId   String?
  status     PromiseStatus
  notes      String?
  verifiedAt DateTime @default(now())
  verifiedBy String? // User name or ID
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  promise    Promise  @relation(fields: [promiseId], references: [id], onDelete: Cascade)
  source     Source?  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
}

model ImplementationStatus {
  id          String        @id @default(uuid())
  promiseId   String        @unique
  status      PromiseStatus
  explanation String?
  lastUpdated DateTime      @default(now())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  promise     Promise       @relation(fields: [promiseId], references: [id], onDelete: Cascade)
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StatusHistory {
  id          String        @id @default(uuid())
  promiseId   String
  status      PromiseStatus
  explanation String?
  changedAt   DateTime      @default(now())
  changedBy   String? // User name or ID
  createdAt   DateTime      @default(now())
  promise     Promise       @relation(fields: [promiseId], references: [id], onDelete: Cascade)
}
